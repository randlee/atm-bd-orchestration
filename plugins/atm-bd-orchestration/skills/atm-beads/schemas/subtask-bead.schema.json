{
  "$defs": {
    "Dependency": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "depends_on_id": {
          "title": "Depends On Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "depends_on_id"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "SubtaskMetadata": {
      "additionalProperties": true,
      "description": "A stage:subtask child's own metadata: the model class of the background subagent that runs it, where it differs from the sprint's.",
      "properties": {
        "model_class": {
          "anyOf": [
            {
              "enum": [
                "astra",
                "terra",
                "luna"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Class"
        },
        "sprint_bead": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sprint Bead"
        }
      },
      "title": "SubtaskMetadata",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "A stage:subtask child. Its id names its parent sprint container; validate_phase checks that bead is a stage:sprint container.",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "dependencies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "parent": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "metadata": {
      "$ref": "#/$defs/SubtaskMetadata",
      "default": {
        "model_class": null,
        "sprint_bead": null
      }
    }
  },
  "required": [
    "id"
  ],
  "title": "SubtaskBead",
  "type": "object"
}
