{
  "task_id": "{{ bead_prefix }}-d-4-qa1-f1",
  "sprint": "d-4",
  "stack": "phase-d",
  "pr_target": "integrate/phase-d",
  "worktree_path": "{{ worktree_base }}/fix/d-4-qa1-f1-retry-jitter",
  "branch": "fix/d-4-qa1-f1-retry-jitter",
  "primary_checkout": "/path/to/{{ repo_name }}",
  "phase_root": "{{ bead_prefix }}-phase-d",
  "test_command": "make test",
  "policy_path": ".claude/project/quality-policy.md",
  "requirements_globs": [
    "docs/requirements.md",
    "docs/*/requirements.md"
  ],
  "adr_globs": [
    "docs/architecture.md",
    "docs/*/architecture.md"
  ],
  "lint_command": "just lint",
  "provider": {
    "create": "gh pr create --base '{base}' --head '{head}' --title '{title}' --body-file '{body_file}'",
    "view": "gh pr view '{number}' --repo '{repository}' --json '{fields}' --jq '{jq}'",
    "edit_base": "gh pr edit '{number}' --base '{base}'",
    "edit_body": "gh pr edit '{number}' --body-file '{body_file}'",
    "comment": "gh pr comment '{number}' --body-file '{body_file}'",
    "comment_view": "gh api 'repos/{repository}/issues/comments/{number}'",
    "checks": "gh api 'repos/{owner}/{repo}/commits/{head_sha}/check-runs'",
    "lookup_by_head": "gh api 'repos/{owner}/{repo}/pulls?head={owner}:{head}&state={state}&per_page=100'",
    "stack_link": "gh stack link '{number}'",
    "stack_view": "gh stack view --json"
  }
}
