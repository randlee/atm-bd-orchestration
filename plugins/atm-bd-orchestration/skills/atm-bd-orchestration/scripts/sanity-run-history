#!/usr/bin/env python3
"""Append a completed sanity run to the repository-local ignored JSONL ledger.

Append: --vars --task --bead --commit --pr-number --iteration --started-at --output [--limit N]
View (read-only): --view --phase <p> --output <vars.json> [--limit N]
Both write {runs: [...]} newest first; rows appended before `commit` was recorded still load.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def fail(message: str) -> None:
    raise SystemExit(f"sanity-run-history: {message}")


def read_vars(path: Path) -> dict[str, object]:
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read completion vars {path}: {exc}")
    if not isinstance(value, dict):
        fail("completion vars must be a JSON object")
    for field, expected in {"sprint": str, "verdict": str, "findings_count": int}.items():
        item = value.get(field)
        if isinstance(item, bool) or not isinstance(item, expected):
            fail(f"completion vars.{field} must be {expected}")
    if value["verdict"] not in {"PASS", "FAIL"}:
        fail("completion vars.verdict must be PASS or FAIL")
    if value["findings_count"] < 0:
        fail("completion vars.findings_count cannot be negative")
    return value


def phase_from_sprint(sprint: str) -> str:
    match = re.fullmatch(r"(?:phase-)?([a-z]+)(?:[-_]?\d+)?", sprint.lower())
    if not match:
        fail(f"cannot derive a phase from sprint {sprint!r}")
    return match.group(1)


def phase_from_bead(bead: str, sprint: str) -> str:
    try:
        result = subprocess.run(
            ["bd", "show", bead, "--json"], check=True, capture_output=True, text=True
        )
        issues = json.loads(result.stdout)
        metadata = issues[0].get("metadata") if isinstance(issues, list) and issues else None
        value = metadata.get("phase") if isinstance(metadata, dict) else None
        match = re.fullmatch(r"(?:phase-)?([a-z][a-z0-9_-]*)", value.lower()) if isinstance(value, str) else None
        if match:
            return match.group(1)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        pass
    return phase_from_sprint(sprint)


def primary_root() -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            check=True, capture_output=True, text=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        fail(f"cannot locate repository common directory: {exc}")
    return Path(result.stdout.strip()).parent


def load_log(path: Path) -> list[dict[str, object]]:
    if not path.exists():
        return []
    records: list[dict[str, object]] = []
    try:
        lines = path.read_text().splitlines()
        for number, line in enumerate(lines, start=1):
            if not line.strip():
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError as exc:
                if number == len(lines):
                    print(f"sanity-run-history: skipping truncated final line in {path}: {exc}", file=sys.stderr)
                    continue
                raise
            if not isinstance(record, dict):
                fail(f"log {path}:{number} is not a JSON object")
            records.append(record)
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read log {path}: {exc}")
    return records


def log_path_for(phase: str) -> Path:
    return primary_root() / ".sc" / "sanity-log" / f"phase-{phase}.jsonl"


def write_view(output: Path, records: list[dict[str, object]], limit: int) -> None:
    visible = records if limit == 0 else records[-limit:]
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps({"runs": list(reversed(visible))}, indent=2) + "\n")


def view(args: argparse.Namespace) -> None:
    """Write the newest `--limit` runs of a phase ledger, newest first, without appending."""
    match = re.fullmatch(r"(?:phase-)?([a-z][a-z0-9_-]*)", args.phase.lower())
    if not match:
        fail("--view requires --phase <p>")
    log_path = log_path_for(match.group(1))
    lock_path = log_path.with_suffix(log_path.suffix + ".lock")
    if not lock_path.exists():
        write_view(args.output, load_log(log_path), args.limit)
        return
    with lock_path.open("r") as lock:
        fcntl.flock(lock, fcntl.LOCK_SH)
        write_view(args.output, load_log(log_path), args.limit)
        fcntl.flock(lock, fcntl.LOCK_UN)


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--view", action="store_true", help="read-only: write the newest runs of --phase")
    parser.add_argument("--phase", default="")
    parser.add_argument("--vars", type=Path)
    parser.add_argument("--task")
    parser.add_argument("--bead")
    parser.add_argument("--commit")
    parser.add_argument("--pr-number", type=int)
    parser.add_argument("--iteration", type=int)
    parser.add_argument("--started-at", type=float)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--limit", type=int, default=10)
    args = parser.parse_args(argv)
    if args.limit < 0:
        fail("--limit must be zero (all) or positive")
    if args.view:
        view(args)
        return
    missing = [flag for flag, value in (("--vars", args.vars), ("--task", args.task), ("--bead", args.bead),
                                        ("--commit", args.commit), ("--pr-number", args.pr_number),
                                        ("--iteration", args.iteration), ("--started-at", args.started_at))
               if value in (None, "")]
    if missing:
        fail("an append requires " + ", ".join(missing))
    if args.pr_number < 1 or args.iteration < 1:
        fail("--pr-number and --iteration must be positive")

    vars = read_vars(args.vars)
    completed = datetime.now(timezone.utc)
    elapsed = max(0, round(completed.timestamp() - args.started_at))
    phase = phase_from_bead(args.bead, vars["sprint"])
    record = {
        "task": args.task, "sprint": vars["sprint"], "phase": phase, "commit": args.commit,
        "pr_number": args.pr_number, "findings": vars["findings_count"],
        "verdict": vars["verdict"], "iteration": args.iteration,
        "completed_at": completed.isoformat().replace("+00:00", "Z"),
        "completed_local": completed.astimezone().strftime("%H:%M"),
        "duration": f"{elapsed // 60}m{elapsed % 60:02d}s",
    }
    log_path = log_path_for(phase)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = log_path.with_suffix(log_path.suffix + ".lock")
    with lock_path.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        records = load_log(log_path)
        with log_path.open("a", encoding="utf-8") as log:
            log.write(json.dumps(record, sort_keys=True) + "\n")
            log.flush()
            os.fsync(log.fileno())
        records.append(record)
        write_view(args.output, records, args.limit)
        fcntl.flock(lock, fcntl.LOCK_UN)


if __name__ == "__main__":
    main()
