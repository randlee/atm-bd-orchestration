#!/usr/bin/env python3
"""Fix-round reviewer scope: which scope-locked reviewers may run, and what they may report.

The scope-locked set is `reviewers_scope_locked` in the repository configuration
(atm-beads/scripts/repo_config.py); there is no built-in list.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "atm-beads" / "scripts"))
import repo_config  # noqa: E402


def scope_locked() -> tuple[str, ...]:
    """The configured scope-locked reviewers; a missing or malformed key is an error, never an empty set."""
    names = repo_config.load()["reviewers_scope_locked"]
    if not isinstance(names, list) or not all(isinstance(n, str) and n for n in names):
        raise repo_config.ConfigError("reviewers_scope_locked must be a list of agent names")
    return tuple(names)


def owned(carried: list[dict], locked: tuple[str, ...]) -> dict[str, list[str]]:
    """Carried finding beads -> {scope-locked reviewer: [its own finding_refs]}; absent reviewer = not dispatched."""
    out: dict[str, list[str]] = {}
    for bead in carried:
        meta = bead.get("metadata") or {}
        reviewer, ref = meta.get("reviewer"), meta.get("finding_ref")
        if reviewer in locked and isinstance(ref, str) and ref:
            out.setdefault(reviewer, []).append(ref)
    return out


def filter_result(reviewer: str, carried: list[dict], result: dict) -> dict:
    """Reduce a scope-locked reviewer result to dispositions on carried beads; nothing else survives."""
    scope = {(b.get("metadata") or {}).get("finding_ref"): b["id"] for b in carried
             if (b.get("metadata") or {}).get("reviewer") == reviewer}
    data = result.get("data", result)
    reported, dropped = {}, []
    for finding in data.get("findings") or []:
        ref = finding.get("id")
        if ref in scope and ref not in reported:
            reported[ref] = finding
        else:
            dropped.append(finding)
    dispositions = [{"bead": bead, "finding_ref": ref,
                     "disposition": (reported[ref].get("disposition") or "open") if ref in reported else "fixed",
                     "evidence": reported.get(ref, {}).get("evidence", "")}
                    for ref, bead in scope.items()]
    return {"reviewer": reviewer, "dispositions": dispositions, "new_findings": [], "dropped_out_of_scope": dropped}


def check(rows: list[dict], locked: tuple[str, ...]) -> list[str]:
    """Fix-round import file -> ids of findings a scope-locked reviewer raised (must be empty)."""
    return [r.get("id", "?") for r in rows if (r.get("metadata") or {}).get("reviewer") in locked]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("owned", "filter", "check"))
    parser.add_argument("--carried", default="", help="bd show <carried ids> --json")
    parser.add_argument("--findings", default="", help="check: the round's finding-bead import JSONL")
    parser.add_argument("--reviewer", default="")
    parser.add_argument("--result", default="", help="the reviewer's fenced-JSON result")
    args = parser.parse_args(argv)
    try:
        locked = scope_locked()
    except repo_config.ConfigError as exc:
        print(f"fix-round-scope: {exc}", file=sys.stderr)
        return 2
    if args.command == "check":
        rows = [json.loads(line) for line in open(args.findings) if line.strip()] if args.findings else []
        bad = check(rows, locked)
        if bad:
            print("FIX_ROUND_ADVERSARIAL_FINDING: " + " ".join(bad), file=sys.stderr)
        return 5 if bad else 0
    carried = json.load(open(args.carried))
    if args.command == "owned":
        print(json.dumps(owned(carried, locked)))
        return 0
    if args.reviewer not in locked or not args.result:
        print(f"filter needs --reviewer in {locked} and --result", file=sys.stderr)
        return 2
    print(json.dumps(filter_result(args.reviewer, carried, json.load(open(args.result)))))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
