#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11,<3.12"
# dependencies = ["pydantic>=2", "pyyaml", "sc-compose>=1.7.0,<2"]
# ///
"""Build close and stack-handoff inputs from the pinned split and selected result."""
from __future__ import annotations

import argparse
import json
import subprocess
from pathlib import Path
import sys

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "atm-beads" / "scripts"))
import close_fields  # noqa: E402
import repo_config  # noqa: E402
import phase_settings  # noqa: E402
import command_timeout  # noqa: E402


class SanityVarsError(ValueError):
    def __init__(self, code, message):
        self.code = code
        super().__init__(f"{code}: {message}")


# One SANITY_VARS code and fix per PhaseSettingsCause: the cause is the enum on the error, never its wording.
PHASE_SETTINGS_CODES = {
    phase_settings.PhaseSettingsCause.PHASE_CONFIG_UNREADABLE: (
        "SANITY_VARS.PHASE_CONFIG_UNREADABLE", "create or repair the named .atm-bd/phase-<phase>.toml and retry"),
    phase_settings.PhaseSettingsCause.LEAD_UNSET: (
        "SANITY_VARS.LEAD_UNSET", "set lead in the named phase configuration to the phase lead's ATM identity and retry"),
    phase_settings.PhaseSettingsCause.DEFAULT_TEAM_UNREADABLE: (
        "SANITY_VARS.DEFAULT_TEAM_UNREADABLE", "repair the named .atm.toml or set team in the phase configuration and retry"),
    phase_settings.PhaseSettingsCause.TEAM_UNSET: (
        "SANITY_VARS.TEAM_UNSET", "set team in the named phase configuration or atm.default_team in .atm.toml and retry"),
    phase_settings.PhaseSettingsCause.CODE_CHECKOUT_INVALID: (
        "SANITY_VARS.CODE_CHECKOUT_INVALID", "set code_checkout in the named phase configuration to a nonempty path or remove it and retry"),
    phase_settings.PhaseSettingsCause.REPO_CONFIG_INVALID: (
        "SANITY_VARS.REPO_CONFIG_INVALID", f"repair {repo_config.RELATIVE_PATH} (the installer renders it) and retry"),
    phase_settings.PhaseSettingsCause.TOOL_IDENTITY_INVALID: (
        "SANITY_VARS.TOOL_IDENTITY_INVALID", f"set tool_identity in {repo_config.RELATIVE_PATH} to <identity>@<team> and retry"),
}


def phase_settings_error(error):
    code, fix = PHASE_SETTINGS_CODES[error.cause]
    return SanityVarsError(code, f"{error}; {fix}")


def task_events(task, phase, root=None):
    root = Path(root) if root is not None else repo_config.repo_root()
    try:
        settings = phase_settings.phase_settings(root, phase)
    except phase_settings.PhaseSettingsError as error:
        raise phase_settings_error(error) from error
    timeout = command_timeout.repo_timeout({}, root)
    command = ["atm", "task", "events", task, "--all", "--json", "--team", settings.team, "--as", settings.lead]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=True)
    except FileNotFoundError as error:
        raise SanityVarsError("SANITY_VARS.ATM_MISSING", "atm executable is missing; install atm and retry") from error
    except subprocess.TimeoutExpired as error:
        raise SanityVarsError("SANITY_VARS.TIMEOUT", f"{' '.join(command)} timed out after {timeout}s; raise gate_timeout_s in the repository configuration and retry") from error
    except (OSError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", "") or str(error)
        raise SanityVarsError("SANITY_VARS.TASK_NOT_FOUND", f"{' '.join(command)} failed: {detail}; verify the team and assign the sanity task before retrying") from error
    try:
        events = json.loads(result.stdout)["events"]
        if not isinstance(events, list) or not events:
            raise ValueError("no task events")
        return events
    except (ValueError, KeyError, TypeError) as error:
        raise SanityVarsError("SANITY_VARS.TASK_NOT_FOUND", f"{' '.join(command)} returned no valid task history: {error}; verify the team and assign the sanity task") from error


def build(manifest, selected, stacked=None, *, events=None):
    for key, expected in (("run_id", manifest["run_id"]), ("commit", manifest["sha"]),
                          ("task_id", manifest["sanity_bead"]), ("checked_bead", manifest["dev_bead"])):
        if selected.get(key) != expected:
            raise ValueError(f"selected {key} does not match manifest")
    if selected.get("reviewer") != "sanity-selected" or selected.get("verdict") not in ("PASS", "FAIL", "CANNOT_RUN"):
        raise ValueError("a selected PASS, FAIL or CANNOT_RUN result is required")
    template = Path(__file__).resolve().parents[1] / "templates/task-close-vars.j2"
    contract = yaml.safe_load(template.read_text().split("---", 2)[1])
    context = manifest.get("close_context")
    if not isinstance(context, dict) or not context:
        raise ValueError("manifest lacks assignment close_context; rerun split with --close-context")
    phase = context.get("phase")
    if not isinstance(phase, str) or not phase.strip():
        raise SanityVarsError("SANITY_VARS.PHASE_UNSET",
                              f"manifest close_context.phase is {json.dumps(phase)}, not the phase id; the dispatch carries it from the "
                              "dev or fix close vars (task-close-vars.j2 `phase`): rerun split with the assignment's --close-context")
    values = {**contract.get("defaults", {}), **context}
    total = manifest["deliverables_total"]
    findings = selected.get("findings") or []
    undone = [{"number": item["deliverable"], "reason": item["issue"]}
              for item in findings if item.get("deliverable", 0) > 0]
    if selected["verdict"] == "FAIL" and not undone:
        undone = [{"number": item["number"], "reason": selected.get("lint_md") or selected.get("findings_md") or "Lint failed"}
                  for item in manifest["assignments"]]
    history = task_events(manifest["sanity_bead"], phase) if events is None else events
    iteration = sum(event.get("event") in {"assigned", "reassigned", "reopened"} for event in history)
    if not iteration:
        raise SanityVarsError("SANITY_VARS.TASK_NOT_FOUND", f"no assignment in `atm task events {manifest['sanity_bead']} --json`; assign the sanity task and retry")
    values.update(task_id=manifest["sanity_bead"], sanity_bead=manifest["sanity_bead"],
                  sanity_task_id=manifest["sanity_bead"], checked_bead=manifest["dev_bead"],
                  dev_task_id=manifest["dev_bead"], branch=manifest["branch"], commit=manifest["sha"],
                  worktree_path=manifest["worktree_path"], sprint=selected["sprint"],
                  checked_title=manifest.get("checked_bead_data", {}).get("title", context.get("checked_title", "")),
                  generated_at=selected.get("generated_at") or selected["completed_at"],
                  verdict=selected["verdict"], findings_count=selected.get("findings_count"),
                  findings_md=selected.get("findings_md") or str(selected.get("error") or ""),
                  lint_md=selected.get("lint_md", ""), undone=undone, deliverables_total=total,
                  deliverables_complete=total - len({item["number"] for item in undone}),
                  deliverables_md=selected.get("findings_md", ""), stacked=stacked,
                  reviewer=selected["reviewer"], run_id=selected["run_id"], selection=selected.get("selection") or [],
                  round=iteration, reviewers_md="Selected independent sanity checks.",
                  evidence=context.get("evidence", ""), outcome=context.get("outcome", "fixed"),
                  findings_blocking=0, findings_important=0, findings_minor=0, findings_ceremony=0,
                  notes_md=json.dumps({"selection": selected.get("selection"), "fallbacks": selected.get("fallbacks", [])}))
    if close_fields.is_fix_bead(manifest.get("checked_bead_data", {})):
        values["carry_forward"] = manifest["dev_bead"]
    allowed = set(contract["required_variables"]) | set(contract.get("defaults", {}))
    values = {key: value for key, value in values.items() if key in allowed}
    missing = set(contract["required_variables_by_role"]["sanity"]) - values.keys()
    if values.get("outcome") == "not_reproducible":
        missing -= {"stack_bead"}
    if missing:
        raise ValueError("assignment close_context lacks " + ", ".join(sorted(missing)))
    reviewers = values["reviewers_round1"]
    if not (isinstance(reviewers, list) and reviewers and all(isinstance(item, str) and item.strip() for item in reviewers)):
        raise ValueError(f"assignment close_context reviewers_round1 must be a non-empty list of reviewer names, got {json.dumps(reviewers)}; "
                         "the dev close copies it from the QA bead's metadata (atm-task-close.py sanity_dispatch)")
    if values.get("outcome") != "not_reproducible":
        required_dispatch = ("stack_bead",)
        empty = [name for name in required_dispatch if not str(values.get(name) or "").strip()]
        if empty:
            raise ValueError("assignment close_context lacks non-empty " + ", ".join(empty))
    return values


def write_stack_input(path, values, manifest):
    """Write a handoff only when this close has a PR-backed stack layer."""
    if values.get("verdict") != "PASS" or values.get("outcome") == "not_reproducible" or not values.get("stack_bead") or not values.get("pr_number"):
        path.unlink(missing_ok=True)
        return False
    context = manifest.get("close_context") or {}
    budget = context.get("budget")
    if budget not in ("full", "lean"):
        raise ValueError("assignment close_context.budget must be full or lean")
    payload = {key: values[key] for key in ("checked_bead", "branch", "commit", "stack_bead")}
    payload.update(pr_number=int(values["pr_number"]), budget=budget,
                   worktree_path=values["worktree_path"], lead=context.get("phase_lead", ""))
    path.write_text(json.dumps(payload))
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", type=Path, required=True)
    parser.add_argument("--selected", type=Path, required=True)
    parser.add_argument("--stack-result", type=Path)
    parser.add_argument("--stack-input", type=Path)
    args = parser.parse_args()
    try:
        manifest = json.loads(args.manifest.read_text())
        selected = json.loads(args.selected.read_text())
        stacked = json.loads(args.stack_result.read_text()) if args.stack_result else None
        values = build(manifest, selected, stacked)
        if args.stack_input:
            write_stack_input(args.stack_input, values, manifest)
    except (OSError, ValueError, KeyError, TypeError) as error:
        parser.exit(2, f"sanity-close-vars: {error}\n")
    print(json.dumps(values, indent=2))


if __name__ == "__main__":
    main()
