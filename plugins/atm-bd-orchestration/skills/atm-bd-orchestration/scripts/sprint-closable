#!/usr/bin/env python3
"""Report whether a sprint container may be closed. Read-only.

Usage:
  sprint-closable <sprint-bead>

Exit 0 and print `closable` when `<sprint>.group-dev`, `.group-sanity` and
`.group-qa` are closed and nothing else under the sprint is open: no fix
group step, restack sanity check or finding (bd refuses to close a parent
with an open child). Otherwise exit 1 with one reason per
line; a sprint with no group prints `no sprint group`. Exit 2 when `bd` fails.
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from typing import Any, Callable

from bd_commands import FINDING_LABEL, BdCommandError

Runner = Callable[..., subprocess.CompletedProcess[str]]
GROUP_STEPS = ("dev", "sanity", "qa")


def bd_json(runner: Runner, *args: str) -> Any:
    argv = ["bd", *args]
    try:
        proc = runner(argv, capture_output=True, text=True)
    except OSError as exc:
        raise BdCommandError(f"{' '.join(argv[:3])} failed: {exc}") from exc
    if proc.returncode:
        detail = (proc.stderr or "").strip() or (proc.stdout or "").strip()
        raise BdCommandError(f"{' '.join(argv[:3])} failed: {detail}")
    try:
        return json.loads(proc.stdout or "null")
    except ValueError as exc:
        raise BdCommandError(f"{' '.join(argv[:3])} returned invalid JSON: {exc}") from exc


def descendants(runner: Runner, bead: str) -> list[dict[str, Any]]:
    """Every bead under `bead`, walking parent-child links breadth first."""
    found: dict[str, dict[str, Any]] = {}
    queue = [bead]
    while queue:
        parent = queue.pop(0)
        rows = bd_json(runner, "list", "--all", "-n", "0", "--parent", parent, "--json") or []
        for row in rows:
            if isinstance(row, dict) and row.get("id") and row["id"] not in found and row["id"] != bead:
                found[row["id"]] = row
                queue.append(row["id"])
    return list(found.values())


def severity(row: dict[str, Any]) -> str:
    metadata = row.get("metadata") if isinstance(row.get("metadata"), dict) else {}
    value = metadata.get("severity")
    if isinstance(value, str) and value:
        return value.lower()
    for label in row.get("labels") or []:
        if label.startswith("severity:"):
            return label.split(":", 1)[1].lower()
    return ""


def role(row: dict[str, Any]) -> str:
    if FINDING_LABEL in (row.get("labels") or []):
        return f"{severity(row) or 'unknown'} finding"
    metadata = row.get("metadata") or {}
    return metadata.get("role") or ("sanity" if metadata.get("dev_bead") else "bead")


def reasons(sprint: str, rows: list[dict[str, Any]]) -> list[str]:
    by_id = {row["id"]: row for row in rows}
    if not any(f"{sprint}.group-{step}" in by_id for step in GROUP_STEPS):
        return ["no sprint group"]
    out = []
    for step in GROUP_STEPS:
        bead = by_id.pop(f"{sprint}.group-{step}", None)
        if bead is None:
            out.append(f"{step} step {sprint}.group-{step} missing")
        elif bead.get("status") != "closed":
            out.append(f"{step} step {sprint}.group-{step} is {bead.get('status') or 'open'}")
    for row in sorted(by_id.values(), key=lambda r: r["id"]):
        if row.get("status") != "closed":
            out.append(f"{role(row)} {row['id']} is {row.get('status') or 'open'} (parent {row.get('parent') or '?'})")
    return out


def main(argv: list[str] | None = None, runner: Runner = subprocess.run) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("sprint")
    args = parser.parse_args(argv)
    try:
        bd_json(runner, "show", args.sprint, "--json")
        found = reasons(args.sprint, descendants(runner, args.sprint))
    except BdCommandError as exc:
        print(f"sprint-closable: {exc}", file=sys.stderr)
        return 2
    if found:
        print("\n".join(found))
        return 1
    print("closable")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
