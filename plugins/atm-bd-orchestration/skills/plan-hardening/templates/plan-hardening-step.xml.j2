---
name: plan-hardening-step
version: 1.0.0
description: Runs one plan-hardening wisp step. One template for both runners - a teammate (an ATM task) and a background subagent (a rendered prompt).
format: xml
required_variables: [step, runner, actor, phase, root, planner, plan_index, beads_dir, workdir]
metadata:
  type: plan-hardening-step
  tags: [stage:plan-hardening]
---
{%- if runner == "teammate" %}{% set teammate = true %}{% elif runner == "subagent" %}{% set teammate = false %}{% else %}{{ runner | runner_must_be_teammate_or_subagent }}{% endif %}
{%- set step_invalid = step|replace("a", "")|replace("b", "")|replace("c", "")|replace("d", "")|replace("e", "")|replace("f", "")|replace("g", "")|replace("h", "")|replace("i", "")|replace("j", "")|replace("k", "")|replace("l", "")|replace("m", "")|replace("n", "")|replace("o", "")|replace("p", "")|replace("q", "")|replace("r", "")|replace("s", "")|replace("t", "")|replace("u", "")|replace("v", "")|replace("w", "")|replace("x", "")|replace("y", "")|replace("z", "")|replace("0", "")|replace("1", "")|replace("2", "")|replace("3", "")|replace("4", "")|replace("5", "")|replace("6", "")|replace("7", "")|replace("8", "")|replace("9", "")|replace(".", "")|replace("_", "")|replace("-", "") %}
{%- set root_invalid = root|replace("a", "")|replace("b", "")|replace("c", "")|replace("d", "")|replace("e", "")|replace("f", "")|replace("g", "")|replace("h", "")|replace("i", "")|replace("j", "")|replace("k", "")|replace("l", "")|replace("m", "")|replace("n", "")|replace("o", "")|replace("p", "")|replace("q", "")|replace("r", "")|replace("s", "")|replace("t", "")|replace("u", "")|replace("v", "")|replace("w", "")|replace("x", "")|replace("y", "")|replace("z", "")|replace("0", "")|replace("1", "")|replace("2", "")|replace("3", "")|replace("4", "")|replace("5", "")|replace("6", "")|replace("7", "")|replace("8", "")|replace("9", "")|replace(".", "")|replace("_", "")|replace("-", "") %}
{%- set planner_invalid = planner|replace("a", "")|replace("b", "")|replace("c", "")|replace("d", "")|replace("e", "")|replace("f", "")|replace("g", "")|replace("h", "")|replace("i", "")|replace("j", "")|replace("k", "")|replace("l", "")|replace("m", "")|replace("n", "")|replace("o", "")|replace("p", "")|replace("q", "")|replace("r", "")|replace("s", "")|replace("t", "")|replace("u", "")|replace("v", "")|replace("w", "")|replace("x", "")|replace("y", "")|replace("z", "")|replace("0", "")|replace("1", "")|replace("2", "")|replace("3", "")|replace("4", "")|replace("5", "")|replace("6", "")|replace("7", "")|replace("8", "")|replace("9", "")|replace(".", "")|replace("_", "")|replace("-", "") %}
{%- set actor_invalid = actor|replace("A", "")|replace("B", "")|replace("C", "")|replace("D", "")|replace("E", "")|replace("F", "")|replace("G", "")|replace("H", "")|replace("I", "")|replace("J", "")|replace("K", "")|replace("L", "")|replace("M", "")|replace("N", "")|replace("O", "")|replace("P", "")|replace("Q", "")|replace("R", "")|replace("S", "")|replace("T", "")|replace("U", "")|replace("V", "")|replace("W", "")|replace("X", "")|replace("Y", "")|replace("Z", "")|replace("a", "")|replace("b", "")|replace("c", "")|replace("d", "")|replace("e", "")|replace("f", "")|replace("g", "")|replace("h", "")|replace("i", "")|replace("j", "")|replace("k", "")|replace("l", "")|replace("m", "")|replace("n", "")|replace("o", "")|replace("p", "")|replace("q", "")|replace("r", "")|replace("s", "")|replace("t", "")|replace("u", "")|replace("v", "")|replace("w", "")|replace("x", "")|replace("y", "")|replace("z", "")|replace("0", "")|replace("1", "")|replace("2", "")|replace("3", "")|replace("4", "")|replace("5", "")|replace("6", "")|replace("7", "")|replace("8", "")|replace("9", "")|replace("_", "")|replace("-", "") %}
{%- if step|length == 0 or step[0] not in "abcdefghijklmnopqrstuvwxyz0123456789" or step_invalid|length != 0 %}{{ "step must match ^[a-z0-9][a-z0-9._-]*$" | int }}{% endif %}
{%- if root|length == 0 or root[0] not in "abcdefghijklmnopqrstuvwxyz0123456789" or root_invalid|length != 0 %}{{ "root must match ^[a-z0-9][a-z0-9._-]*$" | int }}{% endif %}
{%- if planner|length == 0 or planner[0] not in "abcdefghijklmnopqrstuvwxyz0123456789" or planner_invalid|length != 0 %}{{ "planner must match ^[a-z0-9][a-z0-9._-]*$" | int }}{% endif %}
{%- if actor|length == 0 or actor_invalid|length != 0 %}{{ "actor must match ^[A-Za-z0-9_-]+$" | int }}{% endif %}
{%- if "'" in workdir or "\n" in workdir or "'" in beads_dir or "\n" in beads_dir or "'" in plan_index or "\n" in plan_index %}{{ "path contains an unsafe quote or newline" | int }}{% endif %}
<plan-hardening-step id="{{ step }}" runner="{{ runner }}">
  <phase>{{ phase }}</phase>
  <root>{{ root }}</root>
  <instructions><![CDATA[
Your instructions are the description of step bead {{ step }}. Run every shell
command from `{{ workdir }}` with `BEADS_DIR={{ beads_dir }}`. The dispatcher
must pass these exact values to every subagent or teammate; never infer them.
{% if plan_index != 'integration' %}For validate-plan and sprint-review, pass `--index '{{ plan_index }}'` explicitly.
{% else %}For validate-plan and sprint-review, use the integration-branch index.
{% endif %}Save their complete output and exit status; a nonzero exit is a failed step,
not a plan finding or a passing result. This template starts, records and
closes the step.

1. Start:

```bash
set -euo pipefail
cd '{{ workdir }}'
export BEADS_DIR='{{ beads_dir }}'
{% if teammate %}atm task start {{ step }} "plan-hardening step {{ step }}"
{% endif %}bd update {{ step }} --claim --actor {{ actor }}
bd show {{ step }} --json | jq -er '.[0].description'
```

2. Read the plan when the step reviews it:

```bash
set -euo pipefail
bd show {{ root }} --json | jq -e '.[0] | {id, title, description, design, acceptance_criteria}'
bd list --parent {{ root }} -l stage:sprint -n 0 --json \
  | jq -e '[.[] | {id, title, description, design, acceptance_criteria, metadata}]'
```

3. Do what the step description says. In a fix or verify step enumerate every
   filing reported by earlier steps before filtering the fix beads:

```bash
bd list -l phase-{{ phase }},stage:plan-hardening --include-ephemeral --all -n 0 --json |
  jq -r --arg root '{{ root }}' '.[] | select(.metadata.root == $root) |
    (.close_reason // "") | (try capture("(?:^|[[:space:]])filed=(?<ids>[^[:space:]]+)").ids catch empty) |
    select(. != "none") | split(",")[]'
```

   Compare these IDs with `bd list --parent {{ root }} -l stage:plan-fix
   --all -n 0 --json`; if any are absent, fail and report the missing IDs.
   In a fix step, never create sprint or contract beads. If a finding requires
   changing the plan structure, stop and escalate it to the phase lead.

4. File findings when you have any. Write a JSON array to
   `${TMPDIR:-/tmp}/{{ step }}-findings.json`, one object per finding:
   `title`, `description` (the problem and the exact correction, naming the
   bead and field), `severity` (`Blocking`, `Important` or `Minor`) and
   `plan_bead` (the bead it is about). Then run:

```bash
set -euo pipefail
STEP='{{ step }}'
PASS=$(bd show "$STEP" --json | jq -er '.[0].metadata.pass')
jq -e 'type == "array" and all(.[]; type == "object" and
  (.severity | IN("Blocking","Important","Minor")) and
  (.title | type == "string" and length > 0) and
  (.description | type == "string" and length > 0) and
  (.plan_bead | type == "string" and length > 0))' "${TMPDIR:-/tmp}/$STEP-findings.json" >/dev/null
jq -ce '.[]' "${TMPDIR:-/tmp}/$STEP-findings.json" | while IFS= read -r f; do
  existing=$(bd list --parent '{{ root }}' -l 'phase-{{ phase }},stage:plan-fix' --all -n 0 --json \
    | jq -r --arg step "$STEP" --argjson f "$f" '[.[] | select(.metadata.filed_by_step == $step and .title == $f.title and .description == $f.description and .metadata.severity == $f.severity and .metadata.plan_bead == $f.plan_bead) | .id][0] // empty')
  if [[ -n "$existing" ]]; then
    printf '%s\n' "$existing"
    continue
  fi
  bd create "$(jq -er .title <<<"$f")" --parent '{{ root }}' --type task --assignee '{{ planner }}' \
    --no-inherit-labels --labels 'stage:plan-fix' --description "$(jq -er .description <<<"$f")" \
    --metadata "$(jq -c --arg pass "$PASS" --arg step "$STEP" '{pass:$pass, filed_by_step:$step, severity, plan_bead}' <<<"$f")" \
    --actor '{{ actor }}' --json | jq -er '.id'
done | tee "${TMPDIR:-/tmp}/$STEP-filed.txt"
EXPECTED=$(jq length "${TMPDIR:-/tmp}/$STEP-findings.json")
ACTUAL=$(wc -l < "${TMPDIR:-/tmp}/$STEP-filed.txt" | tr -d " ")
test "$EXPECTED" = "$ACTUAL" || { echo "finding filing incomplete: expected $EXPECTED, filed $ACTUAL" >&2; exit 1; }
```

   Close a fix bead you verified with
   `bd close <fix bead> --reason "verified: <what resolves it>" --actor {{ actor }}`;
   note one that is still wrong with
   `bd update <fix bead> --append-notes "still open: <what>" --actor {{ actor }}`.

   A create failure or count mismatch is an execution error: retain the finding
   JSON and return the failure envelope; do not continue until filing is repaired.

5. Close the step only when its work completed. Include `detected=<number>`
   equal to the number of findings in the JSON (0 for non-review steps).
   VERDICT is PASS or FAIL as the description says; a completed review with
   findings is still a successful execution. On an execution error, leave the
   bead open (or reopen it with `bd update {{ step }} --status open --actor
   {{ actor }}`) and return the failure envelope instead of running this close.

```bash
set -euo pipefail
bd close {{ step }} --actor {{ actor }} \
  --reason "VERDICT=<PASS|FAIL> detected=<count> filed=<fix bead ids, comma separated, or none> verified=<closed fix bead ids or none>"
```

{% if teammate -%}
6. On successful execution, close your task with a short report that ends in this fenced JSON, then
   stop: `atm task close {{ step }} completed --stdin`. If the close fails,
   read the error, fix its cause and rerun it.
{% else -%}
6. On successful execution, return only this fenced JSON as your final message. Run no `atm` command.
{% endif %}


```json
{"success": true, "data": {"step": "{{ step }}", "verdict": "PASS|FAIL", "findings": ["<filed fix bead ids>"]}, "error": null}
```

If execution failed, return this envelope with the actual error and a
specific recovery action. `recoverable` is true only when that action can
recover this step. {% if teammate %}Close the task with this fenced report
using `atm task close {{ step }} refused --stdin`; do not run the completed
close.{% else %}Run no ATM command.{% endif %}

```json
{"success": false, "data": {"step": "{{ step }}", "verdict": null, "findings": []}, "error": {"code": "EXECUTION.STEP_FAILED", "message": "<what failed>", "recoverable": true, "suggested_action": "<specific recovery action>"}}
```
  ]]></instructions>
</plan-hardening-step>
