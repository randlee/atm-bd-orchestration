{
  "create": {
    "argv": [
      "gh",
      "pr",
      "create",
      "--base",
      "{base}",
      "--head",
      "{head}",
      "--title",
      "{title}",
      "--body-file",
      "{body_file}"
    ],
    "body": "file",
    "output": "text",
    "result": {
      "url": "stdout"
    }
  },
  "view": {
    "argv": [
      "gh",
      "pr",
      "view",
      "{number}",
      "--repo",
      "{repository}",
      "--json",
      "number,url,baseRefName,mergedAt,mergeCommit,body,headRefOid,updatedAt,author"
    ],
    "body": "none",
    "output": "json",
    "result": {
      "number": "number",
      "url": "url",
      "base": "baseRefName",
      "merged_at": "mergedAt",
      "merge_commit": "mergeCommit.oid",
      "body": "body",
      "head_sha": "headRefOid",
      "author": "author.login",
      "updated_at": "updatedAt"
    }
  },
  "edit_base": {
    "argv": [
      "gh",
      "pr",
      "edit",
      "{number}",
      "--base",
      "{base}"
    ],
    "body": "none",
    "output": "exit_code",
    "result": {}
  },
  "comment": {
    "argv": [
      "gh",
      "pr",
      "comment",
      "{number}",
      "--body-file",
      "{body_file}"
    ],
    "body": "file",
    "output": "exit_code",
    "result": {}
  },
  "checks": {
    "argv": [
      "gh",
      "api",
      "repos/{owner}/{repo}/commits/{head_sha}/check-runs"
    ],
    "body": "none",
    "output": "json",
    "result": {}
  },
  "lookup_by_head": {
    "argv": [
      "gh",
      "api",
      "repos/{owner}/{repo}/pulls?head={owner}:{head}&state={state}&per_page=100"
    ],
    "body": "none",
    "output": "json",
    "result": {
      "number": "number",
      "url": "html_url",
      "base": "base.ref",
      "merged_at": "merged_at",
      "merge_commit": "merge_commit_sha",
      "body": "body",
      "head_sha": "head.sha",
      "author": "user.login",
      "updated_at": "updated_at"
    }
  },
  "stack_link": {
    "argv": [
      "gh",
      "stack",
      "link",
      "{number}"
    ],
    "body": "none",
    "output": "exit_code",
    "result": {}
  },
  "stack_view": {
    "argv": [
      "gh",
      "stack",
      "view",
      "--json"
    ],
    "body": "none",
    "output": "json",
    "result": {}
  },
  "comment_view": {
    "argv": [
      "gh",
      "api",
      "repos/{repository}/issues/comments/{number}"
    ],
    "body": "none",
    "output": "json",
    "result": {
      "body": "body",
      "url": "html_url",
      "author": "user.login",
      "updated_at": "updated_at"
    }
  }
}
